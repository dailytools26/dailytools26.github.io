---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// SEO 설정
const title = '계산기 공식 및 법령 기준 문서';
const description = 'DailyTools26에서 제공하는 세금, 부동산, 주식 관련 도구들의 정확한 계산 공식, 공제 항목, 그리고 관련 세법 및 기준 법령을 상세히 설명합니다.';
const keywords = ['계산기 공식', '세금 계산 기준', '취득세법', '증여세율', 'S-RIM 공식', '주식 복리', '포지션 사이징'];

const allDocs = await getCollection('docs');

// Sort: Tax (1), Real Estate (2), Stock (3)
const categoryOrder: Record<string, number> = { 'tax': 1, 'real-estate': 2, 'stock': 3 };

const sortedDocs = allDocs.sort((a, b) => {
  if (a.data.category !== b.data.category) {
    return (categoryOrder[a.data.category] || 99) - (categoryOrder[b.data.category] || 99);
  }
  return a.data.order - b.data.order;
});

const groupedCategories: Array<{ slug: string; label: string; items: typeof allDocs }> = [];
sortedDocs.forEach(d => {
  let cat = groupedCategories.find(c => c.slug === d.data.category);
  if (!cat) {
    cat = { slug: d.data.category, label: d.data.categoryLabel, items: [] };
    groupedCategories.push(cat);
  }
  cat.items.push(d);
});

// 아이콘 매핑
const iconMap: Record<string, string> = {
  'doc-salary': '💳',
  'doc-freelancer': '💼',
  'doc-retirement': '⏳',
  'doc-gift-inheritance': '🎁',
  'doc-overseas-stock': '✈️',
  'doc-acquisition': '🏠',
  'doc-commercial-vat': '🏢',
  'doc-average': '📉',
  'doc-position-size': '🛡️',
  'doc-srim': '🧮',
  'doc-dividend-yield': '🪙',
  'doc-domestic-tax': '💸'
};
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="container portal-container">
    <header class="portal-header">
      <span class="portal-category-badge">Reference Center</span>
      <h1>계산 공식 및 법령 기준 문서</h1>
      <p class="lead-text">DailyTools26의 모든 도구들은 대한민국 세법, 금융 공학 표준 산식, 그리고 최신 법률 개정안을 바탕으로 설계되었습니다. 각 도구의 상세 작동 원리와 공식을 확인하실 수 있습니다.</p>
    </header>

    <div class="portal-categories-wrapper">
      {groupedCategories.map((cat, index) => (
        <section class="portal-section">
          <h2 class="section-title">
            <span class="section-num">0{index + 1}</span> {cat.label}
          </h2>
          <div class="docs-grid">
            {cat.items.map(doc => (
              <a href={`/docs/${doc.id}`} class="doc-portal-card">
                <div class="card-icon">{iconMap[doc.id] || '📄'}</div>
                <div class="card-content">
                  <h3>{doc.data.title}</h3>
                  <p>{doc.data.description}</p>
                </div>
                <span class="read-more">
                  자세히 보기 <span class="arrow">&rarr;</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .portal-container {
    padding-top: 4rem;
    padding-bottom: 6rem;
    max-width: 1000px;
  }

  .portal-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .portal-category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portal-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .lead-text {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }

  .portal-categories-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .portal-section {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-num {
    font-size: 1rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.8;
    font-family: monospace;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .docs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 카드 디자인 */
  .doc-portal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .doc-portal-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  /* 호버 시 엑센트 글로우 효과 */
  .doc-portal-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .doc-portal-card:hover::after {
    transform: scaleX(1);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1.25rem;
  }

  .card-content {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .card-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .card-content p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color 0.2s ease;
  }

  .doc-portal-card:hover .read-more {
    color: var(--accent);
  }

  .arrow {
    transition: transform 0.25s ease;
  }

  .doc-portal-card:hover .arrow {
    transform: translateX(4px);
  }
</style>

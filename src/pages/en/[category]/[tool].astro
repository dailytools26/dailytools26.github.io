---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { tools } from '../../../data/tools';
import { getLangFromUrl } from '../../../i18n/utils';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { category: tool.category, tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const title = tool.name[lang] || tool.name['ko'];
const description = tool.description[lang] || tool.description['ko'];
const keywords = tool.tags;

let ToolComponent;
try {
  const component = await import(`../../../components/tools/${tool.id}.astro`);
  ToolComponent = component.default;
} catch (e) {
  // fallback
}
---

<Layout title={title} description={description} keywords={keywords}>
  <Breadcrumb tool={tool} />
  
  <div class="container tool-container">
    <div class="tool-header">
      <div class="tool-title-wrapper">
        <span class="tool-icon">{tool.icon}</span>
        <h1 class="tool-title">{title}</h1>
      </div>
      <p class="tool-desc">{description}</p>
      
      <div class="tool-tags">
        {tool.tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </div>
    
    <div class="tool-workspace">
      {ToolComponent ? (
        <ToolComponent />
      ) : (
        <div class="tool-placeholder">
          <p>Tool component is under construction.</p>
          <small>Create <code>src/components/tools/{tool.id}.astro</code></small>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  /* Same styles as ko version */
  .tool-container {
    max-width: 900px;
    padding-bottom: 5rem;
  }

  .tool-header {
    margin-bottom: 3rem;
  }

  .tool-title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tool-icon {
    font-size: 2.5rem;
    background: var(--bg-card);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .tool-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
  }

  .tool-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.875rem;
    background: var(--bg-hover);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .tool-workspace {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    min-height: 400px;
  }

  .tool-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-muted);
    text-align: center;
    padding: 3rem;
  }
  
  .tool-placeholder code {
    background: var(--bg-primary);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-top: 1rem;
  }
</style>

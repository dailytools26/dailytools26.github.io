---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SearchBar from '../components/SearchBar.astro';
import ToolGrid from '../components/ToolGrid.astro';
import SiteIntro from '../components/SiteIntro.astro';
---

<Layout
  title="무료 온라인 계산 도구 모음 — 세금·투자·재무 계산기"
  description="웹 개발자와 직장인을 위한 무료 온라인 계산 도구 모음. 종합소득세, 근로소득세, 배당수익률, 해외주식 세금, 포지션 사이징, 은퇴 자산 계산 등 일상적인 재무 계산을 빠르게 처리하세요."
>
  <Hero />
  <SearchBar />
  <ToolGrid />
  <SiteIntro />
</Layout>


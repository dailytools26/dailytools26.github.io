---
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const i18n = {
  ko: {
    investSetting: '투자 설정',
    initCapital: '초기 투자 금액',
    monthlySavings: '월 적립식 투자금',
    annualDivYield: '연 배당수익률 (%)',
    annualGrowth: '연 주가상승률 (%)',
    investPeriod: '투자 기간 (년)',
    taxRate: '배당 소득세율 (%)',
    results: '시뮬레이션 결과',
    withDRIP: '배당 재투자 시 최종 자산',
    withoutDRIP: '배당 미재투자 시 최종 자산',
    totalDivReceived: '누적 세후 배당금',
    finalMonthlyDiv: '최종 월 배당금 (세후)',
    dripGain: '재투자 효과 (자산 증가분)',
    timeline: '기간별 자산 비교',
    year: '년차',
    withDripCol: '재투자 자산',
    withoutDripCol: '미재투자 자산',
    calculate: '시뮬레이션 실행',
    clear: '초기화',
    placeholderInit: '초기 자금 (예: 10000000)',
    placeholderSavings: '월 적립금 (예: 500000)',
    placeholderYield: '배당률 (예: 4.5)',
    placeholderGrowth: '상승률 (예: 5)',
    placeholderPeriod: '기간 (예: 10)',
    placeholderTax: '세율 (예: 15.4)',
  },
  en: {
    investSetting: 'Investment Settings',
    initCapital: 'Initial Investment',
    monthlySavings: 'Monthly Savings',
    annualDivYield: 'Annual Dividend Yield (%)',
    annualGrowth: 'Annual Stock Growth (%)',
    investPeriod: 'Duration (Years)',
    taxRate: 'Dividend Tax Rate (%)',
    results: 'Simulation Results',
    withDRIP: 'Final Value with DRIP',
    withoutDRIP: 'Final Value without DRIP',
    totalDivReceived: 'Cumulative Net Dividends',
    finalMonthlyDiv: 'Final Monthly Dividend',
    dripGain: 'DRIP Surplus',
    timeline: 'Growth Comparison Over Time',
    year: 'Year',
    withDripCol: 'With DRIP',
    withoutDripCol: 'Without DRIP',
    calculate: 'Run Simulation',
    clear: 'Clear',
    placeholderInit: 'Initial Capital (e.g. 10000000)',
    placeholderSavings: 'Monthly Savings (e.g. 500000)',
    placeholderYield: 'Div Yield (e.g. 4.5)',
    placeholderGrowth: 'Stock Growth (e.g. 5)',
    placeholderPeriod: 'Duration (e.g. 10)',
    placeholderTax: 'Tax (e.g. 15.4)',
  }
};

const t = i18n[lang] || i18n['ko'];
---

<div class="tool-stock-dividend">
  <div class="calculator-grid">
    <!-- 입력 영역 -->
    <div class="input-section">
      <div class="input-group-wrapper">
        <h3>{t.investSetting}</h3>
        <div class="input-group">
          <label for="init-capital">{t.initCapital}</label>
          <input type="number" id="init-capital" placeholder={t.placeholderInit} min="0" step="any" value="10000000" />
        </div>
        <div class="input-group">
          <label for="monthly-savings">{t.monthlySavings}</label>
          <input type="number" id="monthly-savings" placeholder={t.placeholderSavings} min="0" step="any" value="500000" />
        </div>
        <div class="input-group-row">
          <div class="input-group half">
            <label for="div-yield">{t.annualDivYield}</label>
            <input type="number" id="div-yield" placeholder={t.placeholderYield} min="0" step="any" value="5" />
          </div>
          <div class="input-group half">
            <label for="growth-rate">{t.annualGrowth}</label>
            <input type="number" id="growth-rate" placeholder={t.placeholderGrowth} min="0" step="any" value="5" />
          </div>
        </div>
        <div class="input-group-row">
          <div class="input-group half">
            <label for="invest-period">{t.investPeriod}</label>
            <input type="number" id="invest-period" placeholder={t.placeholderPeriod} min="1" max="50" value="10" />
          </div>
          <div class="input-group half">
            <label for="tax-rate">{t.taxRate}</label>
            <input type="number" id="tax-rate" placeholder={t.placeholderTax} min="0" max="100" step="any" value="15.4" />
          </div>
        </div>
      </div>

      <div class="action-buttons">
        <button id="calc-btn" class="btn-primary">{t.calculate}</button>
        <button id="clear-btn" class="btn-secondary">{t.clear}</button>
      </div>
    </div>

    <!-- 결과 영역 -->
    <div class="result-section">
      <h3>{t.results}</h3>

      <div class="result-box highlighted">
        <span class="result-label">{t.withDRIP}</span>
        <span class="result-value accent" id="res-with-drip">0 원</span>
      </div>
      <div class="result-box">
        <span class="result-label">{t.withoutDRIP}</span>
        <span class="result-value" id="res-without-drip">0 원</span>
      </div>
      
      <div class="result-box-row">
        <div class="result-box half">
          <span class="result-label">{t.dripGain}</span>
          <span class="result-value success-text" id="res-drip-surplus">0 원</span>
        </div>
        <div class="result-box half">
          <span class="result-label">{t.finalMonthlyDiv}</span>
          <span class="result-value" id="res-final-monthly-div">0 원</span>
        </div>
      </div>

      <!-- 타임라인 그래프/표 시각화 -->
      <div class="timeline-wrapper">
        <label>{t.timeline}</label>
        <div class="chart-container" id="chart-bars">
          <!-- Dynamically generated visual comparison bars -->
        </div>
        
        <div class="timeline-table-container">
          <table>
            <thead>
              <tr>
                <th>{t.year}</th>
                <th>{t.withDripCol}</th>
                <th>{t.withoutDripCol}</th>
                <th>{t.dripGain}</th>
              </tr>
            </thead>
            <tbody id="timeline-tbody">
              <!-- Dynamically populated every N years -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tool-stock-dividend {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .calculator-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group-wrapper {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  h3 {
    margin: 0 0 1.25rem 0;
    font-size: 1.125rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .input-group:last-child {
    margin-bottom: 0;
  }

  .input-group-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .input-group-row:last-child {
    margin-bottom: 0;
  }

  .input-group.half {
    flex: 1;
    margin-bottom: 0;
  }

  label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  input {
    width: 100%;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-size: 1rem;
    transition: all 0.2s;
  }

  input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  button {
    flex: 1;
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .result-section {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-box {
    background: var(--bg-hover);
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .result-box.highlighted {
    background: rgba(0, 220, 130, 0.03);
    border-color: rgba(0, 220, 130, 0.2);
  }

  .result-box-row {
    display: flex;
    gap: 1rem;
  }

  .result-box.half {
    flex: 1;
  }

  .result-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .result-value {
    font-size: 1.75rem;
    font-weight: 700;
    word-break: break-all;
  }

  .result-value.accent {
    color: var(--accent);
  }

  .success-text {
    color: #00DC82;
  }

  /* Timeline visualization chart */
  .timeline-wrapper {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .timeline-wrapper label {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .chart-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .chart-bar-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chart-year-label {
    font-size: 0.75rem;
    font-weight: bold;
    color: var(--text-secondary);
  }

  .chart-bar-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chart-bar-track {
    flex: 1;
    height: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 9999px;
    position: relative;
    overflow: hidden;
  }

  .chart-bar-fill {
    height: 100%;
    border-radius: 9999px;
    width: 0;
    transition: width 0.5s ease-out;
  }

  .chart-bar-fill.drip {
    background: linear-gradient(to right, #00DC82, #36E4DA);
  }

  .chart-bar-fill.nodrip {
    background: #475569;
  }

  .chart-bar-val {
    font-size: 0.75rem;
    font-weight: 600;
    width: 100px;
    text-align: right;
    white-space: nowrap;
  }

  /* Timeline Table styling */
  .timeline-table-container {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    background: var(--bg-hover);
    padding: 0.6rem 0.8rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  td {
    padding: 0.6rem 0.8rem;
    font-size: 0.825rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
  }

  tr:last-child td {
    border-bottom: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const initCapitalInput = document.getElementById('init-capital') as HTMLInputElement;
    const monthlySavingsInput = document.getElementById('monthly-savings') as HTMLInputElement;
    const divYieldInput = document.getElementById('div-yield') as HTMLInputElement;
    const growthRateInput = document.getElementById('growth-rate') as HTMLInputElement;
    const periodInput = document.getElementById('invest-period') as HTMLInputElement;
    const taxRateInput = document.getElementById('tax-rate') as HTMLInputElement;

    // Outputs
    const resWithDrip = document.getElementById('res-with-drip');
    const resWithoutDrip = document.getElementById('res-without-drip');
    const resDripSurplus = document.getElementById('res-drip-surplus');
    const resFinalMonthlyDiv = document.getElementById('res-final-monthly-div');
    const chartBars = document.getElementById('chart-bars');
    const timelineTbody = document.getElementById('timeline-tbody');

    // Buttons
    const calcBtn = document.getElementById('calc-btn');
    const clearBtn = document.getElementById('clear-btn');

    const formatNumber = (num: number, unit = ' 원') => {
      // 억 단위 포맷 지원
      if (num >= 100000000) {
        const eok = Math.floor(num / 100000000);
        const man = Math.round((num % 100000000) / 10000);
        return man > 0 
          ? `${eok}억 ${new Intl.NumberFormat().format(man)}만${unit}`
          : `${eok}억${unit}`;
      }
      return new Intl.NumberFormat().format(Math.round(num)) + unit;
    };

    const calculate = () => {
      const initCapital = parseFloat(initCapitalInput.value) || 0;
      const monthlySavings = parseFloat(monthlySavingsInput.value) || 0;
      const annualDivYield = parseFloat(divYieldInput.value) || 0;
      const annualGrowth = parseFloat(growthRateInput.value) || 0;
      const period = parseInt(periodInput.value) || 10;
      const taxRate = parseFloat(taxRateInput.value) || 15.4;

      if (period <= 0) return;

      const totalMonths = period * 12;
      const monthlyGrowth = annualGrowth / 12 / 100;
      const monthlyDivYield = annualDivYield / 12 / 100;
      const netTaxMultiplier = 1 - taxRate / 100;

      // Simulation states
      let valueDrip = initCapital;
      let valueNoDrip = initCapital;
      let cashNoDrip = 0; // accumulated dividends for no DRIP scenario

      // To store results every N years (or every year if period is small)
      const interval = period > 15 ? 5 : (period > 5 ? 2 : 1);
      const timelineData: Array<{ year: number, dripVal: number, noDripVal: number, surplus: number }> = [];

      for (let month = 1; month <= totalMonths; month++) {
        // SCENARIO 1: WITH DRIP
        // 1. Stock growth
        valueDrip = valueDrip * (1 + monthlyGrowth);
        // 2. Add savings
        valueDrip += monthlySavings;
        // 3. Dividend received and reinvested
        const divDrip = valueDrip * monthlyDivYield;
        valueDrip += divDrip * netTaxMultiplier;

        // SCENARIO 2: WITHOUT DRIP
        // 1. Stock growth
        valueNoDrip = valueNoDrip * (1 + monthlyGrowth);
        // 2. Add savings
        valueNoDrip += monthlySavings;
        // 3. Dividend received as cash
        const divNoDrip = valueNoDrip * monthlyDivYield;
        cashNoDrip += divNoDrip * netTaxMultiplier;

        // Record year-end data
        if (month % 12 === 0) {
          const currentYear = month / 12;
          if (currentYear % interval === 0 || currentYear === period) {
            timelineData.push({
              year: currentYear,
              dripVal: valueDrip,
              noDripVal: valueNoDrip + cashNoDrip,
              surplus: valueDrip - (valueNoDrip + cashNoDrip)
            });
          }
        }
      }

      const totalWealthDrip = valueDrip;
      const totalWealthNoDrip = valueNoDrip + cashNoDrip;
      const dripSurplus = totalWealthDrip - totalWealthNoDrip;

      // Final monthly dividend payment estimation (based on final year asset)
      const finalMonthlyDivDrip = totalWealthDrip * monthlyDivYield * netTaxMultiplier;

      // Display main stats
      if (resWithDrip) resWithDrip.textContent = formatNumber(totalWealthDrip);
      if (resWithoutDrip) resWithoutDrip.textContent = formatNumber(totalWealthNoDrip);
      if (resDripSurplus) {
        resDripSurplus.textContent = formatNumber(dripSurplus);
        resDripSurplus.className = `result-value ${dripSurplus >= 0 ? 'success-text' : 'danger-text'}`;
      }
      if (resFinalMonthlyDiv) resFinalMonthlyDiv.textContent = formatNumber(finalMonthlyDivDrip);

      // Display timeline table
      if (timelineTbody) {
        timelineTbody.innerHTML = '';
        timelineData.forEach(data => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td style="font-weight: bold; color: var(--accent);">${data.year}년차</td>
            <td>${formatNumber(data.dripVal)}</td>
            <td>${formatNumber(data.noDripVal)}</td>
            <td style="color: #00DC82; font-weight: 600;">+${formatNumber(data.surplus)}</td>
          `;
          timelineTbody.appendChild(tr);
        });
      }

      // Display timeline comparison bars
      if (chartBars && timelineData.length > 0) {
        chartBars.innerHTML = '';
        const maxVal = Math.max(...timelineData.map(d => d.dripVal));

        timelineData.forEach(data => {
          const dripPercent = (data.dripVal / maxVal) * 100;
          const noDripPercent = (data.noDripVal / maxVal) * 100;

          const group = document.createElement('div');
          group.className = 'chart-bar-group';
          group.innerHTML = `
            <span class="chart-year-label">${data.year}년차</span>
            <div class="chart-bar-row">
              <div class="chart-bar-track">
                <div class="chart-bar-fill drip" style="width: ${dripPercent}%"></div>
              </div>
              <span class="chart-bar-val text-gradient">${formatNumber(data.dripVal)}</span>
            </div>
            <div class="chart-bar-row">
              <div class="chart-bar-track">
                <div class="chart-bar-fill nodrip" style="width: ${noDripPercent}%"></div>
              </div>
              <span class="chart-bar-val" style="color: var(--text-secondary);">${formatNumber(data.noDripVal)}</span>
            </div>
          `;
          chartBars.appendChild(group);
        });
      }
    };

    const clear = () => {
      initCapitalInput.value = '10000000';
      monthlySavingsInput.value = '500000';
      divYieldInput.value = '5';
      growthRateInput.value = '5';
      periodInput.value = '10';
      taxRateInput.value = '15.4';

      if (resWithDrip) resWithDrip.textContent = '0 원';
      if (resWithoutDrip) resWithoutDrip.textContent = '0 원';
      if (resDripSurplus) resDripSurplus.textContent = '0 원';
      if (resFinalMonthlyDiv) resFinalMonthlyDiv.textContent = '0 원';

      if (chartBars) chartBars.innerHTML = '';
      if (timelineTbody) timelineTbody.innerHTML = '';
      
      calculate(); // Run initial safe calculation
    };

    if (calcBtn) calcBtn.addEventListener('click', calculate);
    if (clearBtn) clearBtn.addEventListener('click', clear);

    // Initial simulation
    calculate();
  });
</script>

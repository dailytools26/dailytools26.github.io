---
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const i18n = {
  ko: {
    title: '매수 가능 수량 계산기',
    budget: '투자 가용 예수금 (원)',
    price: '매수 예정 단가 (원)',
    feeRate: '증권사 수수료율 (%)',
    calculate: '계산하기',
    clear: '초기화',
    results: '계산 결과',
    maxQty: '매수 가능 수량',
    totalCost: '총 주식 매수 금액',
    totalFees: '예상 거래 수수료',
    remaining: '남는 예수금 (잔액)',
    placeholderBudget: '가용 자금 입력 (예: 5000000)',
    placeholderPrice: '매수가 입력 (예: 65000)'
  },
  en: {
    title: 'Stock Buy Quantity Calculator',
    budget: 'Available Budget (KRW)',
    price: 'Expected Purchase Price (KRW)',
    feeRate: 'Brokerage Fee Rate (%)',
    calculate: 'Calculate',
    clear: 'Clear',
    results: 'Calculation Results',
    maxQty: 'Max Shares to Buy',
    totalCost: 'Total Stock Cost',
    totalFees: 'Estimated Fees',
    remaining: 'Remaining Balance',
    placeholderBudget: 'Enter budget (e.g. 5000000)',
    placeholderPrice: 'Enter share price (e.g. 65000)'
  }
};

const t = i18n[lang] || i18n['ko'];
---

<div class="tool-quantity-calculator">
  <div class="calculator-container">
    <div class="input-section">
      <div class="input-group-wrapper">
        <h3>{t.title}</h3>
        
        <div class="input-group">
          <label for="calc-budget">{t.budget}</label>
          <input type="number" id="calc-budget" placeholder={t.placeholderBudget} min="0" step="10000" />
        </div>

        <div class="input-group">
          <label for="calc-price">{t.price}</label>
          <input type="number" id="calc-price" placeholder={t.placeholderPrice} min="0" step="any" />
        </div>

        <div class="input-group">
          <label for="calc-fee-rate">{t.feeRate}</label>
          <input type="number" id="calc-fee-rate" value="0.015" min="0" max="5" step="0.001" />
        </div>
      </div>

      <div class="action-buttons">
        <button id="calc-btn" class="btn-primary">{t.calculate}</button>
        <button id="clear-btn" class="btn-secondary">{t.clear}</button>
      </div>
    </div>

    <!-- 결과 영역 -->
    <div class="result-section">
      <h3>{t.results}</h3>
      
      <div class="result-box highlighted">
        <span class="result-label">{t.maxQty}</span>
        <span class="result-value accent" id="res-max-qty">0 주</span>
      </div>

      <div class="tax-detail-list">
        <div class="detail-item">
          <span>{t.totalCost}</span>
          <span id="res-total-cost">0 원</span>
        </div>
        <div class="detail-item">
          <span>{t.totalFees}</span>
          <span id="res-total-fees">0 원</span>
        </div>
        <div class="detail-item">
          <span>{t.remaining}</span>
          <span id="res-remaining">0 원</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tool-quantity-calculator {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .calculator-container {
    max-width: 600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group-wrapper {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  h3 {
    margin: 0 0 1.25rem 0;
    font-size: 1.125rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .input-group:last-child {
    margin-bottom: 0;
  }

  label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  input[type="number"] {
    width: 100%;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-size: 1rem;
    transition: all 0.2s;
  }

  input[type="number"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .result-section {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-box {
    background: var(--bg-hover);
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .result-box.highlighted {
    background: rgba(0, 220, 130, 0.03);
    border-color: rgba(0, 220, 130, 0.2);
  }

  .result-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .result-value {
    font-size: 1.75rem;
    font-weight: 700;
    word-break: break-all;
  }

  .result-value.accent {
    color: var(--accent);
  }

  .tax-detail-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .detail-item span:last-child {
    color: var(--text-primary);
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const budgetInput = document.getElementById('calc-budget') as HTMLInputElement;
    const priceInput = document.getElementById('calc-price') as HTMLInputElement;
    const feeRateInput = document.getElementById('calc-fee-rate') as HTMLInputElement;

    // Outputs
    const resMaxQty = document.getElementById('res-max-qty');
    const resTotalCost = document.getElementById('res-total-cost');
    const resTotalFees = document.getElementById('res-total-fees');
    const resRemaining = document.getElementById('res-remaining');

    // Buttons
    const calcBtn = document.getElementById('calc-btn');
    const clearBtn = document.getElementById('clear-btn');

    const formatNumber = (num: number, unit = '') => {
      return new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(num) + unit;
    };

    const calculate = () => {
      const budget = parseFloat(budgetInput.value) || 0;
      const price = parseFloat(priceInput.value) || 0;
      const feeRate = (parseFloat(feeRateInput.value) || 0) / 100;

      if (budget <= 0 || price <= 0) return;

      // Price including buying fee
      const effectiveCostPerShare = price * (1 + feeRate);

      // Max shares (must be integer)
      const maxShares = Math.floor(budget / effectiveCostPerShare);

      // Total costs
      const stockCost = maxShares * price;
      const buyFee = Math.floor(stockCost * feeRate);
      const totalOutflow = stockCost + buyFee;
      const remainingBalance = budget - totalOutflow;

      const isKo = document.documentElement.lang === 'ko';
      const unitWon = isKo ? ' 원' : ' KRW';
      const unitShares = isKo ? ' 주' : ' Shares';

      if (resMaxQty) resMaxQty.textContent = formatNumber(maxShares, unitShares);
      if (resTotalCost) resTotalCost.textContent = formatNumber(stockCost, unitWon);
      if (resTotalFees) resTotalFees.textContent = formatNumber(buyFee, unitWon);
      if (resRemaining) resRemaining.textContent = formatNumber(remainingBalance, unitWon);
    };

    const clear = () => {
      budgetInput.value = '';
      priceInput.value = '';
      feeRateInput.value = '0.015';

      if (resMaxQty) resMaxQty.textContent = '0 주';
      if (resTotalCost) resTotalCost.textContent = '0 원';
      if (resTotalFees) resTotalFees.textContent = '0 원';
      if (resRemaining) resRemaining.textContent = '0 원';
    };

    if (calcBtn) calcBtn.addEventListener('click', calculate);
    if (clearBtn) clearBtn.addEventListener('click', clear);

    // Enter key support
    const inputs = [budgetInput, priceInput, feeRateInput];
    inputs.forEach(input => {
      if (input) {
        input.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            calculate();
          }
        });
      }
    });
  });
</script>

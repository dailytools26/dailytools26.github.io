---
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const i18n = {
  ko: {
    title: '주식 분할매수 계산기',
    totalBudget: '총 분할매수 예산 (원)',
    basePrice: '기준 시작가 (원)',
    stepsCount: '분할 매수 차수 (차)',
    intervalPercent: '차수별 하락 간격 (%)',
    strategyType: '분할 매수 전략',
    strategyEqual: '균등 분할 (동일 비중)',
    strategyMartingale: '마틴게일 분할 (차수별 2배수 증액)',
    strategyFibonacci: '피보나치 분할 (안정적 가중치)',
    calculate: '매수 포트폴리오 생성',
    clear: '초기화',
    results: '분할 매수 가이드 테이블',
    summaryTitle: '매수 실행 요약',
    totalSpent: '최종 소요 예산',
    remainingCash: '남는 예수금',
    avgPrice: '최종 매수 후 평균 단가',
    totalQty: '최종 누적 보유 수량',
    stepCol: '차수',
    priceCol: '매수 가격',
    dropCol: '하락률',
    weightCol: '비중',
    qtyCol: '매수 수량',
    amountCol: '매수 금액',
    cumAvgCol: '매수 후 평단',
    placeholderBudget: '예산 입력 (예: 10000000)',
    placeholderPrice: '시작가 입력 (예: 50000)'
  },
  en: {
    title: 'Stock Split Buy Calculator',
    totalBudget: 'Total Split Buy Budget (KRW)',
    basePrice: 'Base Entry Price (KRW)',
    stepsCount: 'Number of Buy Steps',
    intervalPercent: 'Price Drop Interval (%)',
    strategyType: 'Allocation Strategy',
    strategyEqual: 'Equal Allocation (Even weights)',
    strategyMartingale: 'Martingale (Double weight each step)',
    strategyFibonacci: 'Fibonacci (Conservative weights)',
    calculate: 'Generate Buy Plan',
    clear: 'Clear',
    results: 'Split Buying Plan Table',
    summaryTitle: 'Execution Summary',
    totalSpent: 'Total Budget Spent',
    remainingCash: 'Remaining Cash',
    avgPrice: 'Final Average Price',
    totalQty: 'Total Accumulated Shares',
    stepCol: 'Step',
    priceCol: 'Target Price',
    dropCol: 'Price Drop',
    weightCol: 'Weight',
    qtyCol: 'Shares to Buy',
    amountCol: 'Allocated Budget',
    cumAvgCol: 'Running Average',
    placeholderBudget: 'Enter budget (e.g. 10000000)',
    placeholderPrice: 'Enter base price (e.g. 50000)'
  }
};

const t = i18n[lang] || i18n['ko'];
---

<div class="tool-split-buy">
  <div class="calculator-grid">
    <!-- 입력 영역 -->
    <div class="input-section">
      <div class="input-group-wrapper">
        <h3>{t.title}</h3>
        
        <div class="input-group">
          <label for="split-budget">{t.totalBudget}</label>
          <input type="number" id="split-budget" placeholder={t.placeholderBudget} min="0" step="500000" />
        </div>

        <div class="input-group">
          <label for="split-base-price">{t.basePrice}</label>
          <input type="number" id="split-base-price" placeholder={t.placeholderPrice} min="0" step="any" />
        </div>

        <div class="input-group-row">
          <div class="input-group half">
            <label for="split-steps">{t.stepsCount}</label>
            <input type="number" id="split-steps" min="2" max="10" value="4" />
          </div>
          <div class="input-group half">
            <label for="split-interval">{t.intervalPercent}</label>
            <input type="number" id="split-interval" min="0.1" max="30" step="0.1" value="3" />
          </div>
        </div>

        <div class="input-group">
          <label for="split-strategy">{t.strategyType}</label>
          <select id="split-strategy">
            <option value="equal" selected>{t.strategyEqual}</option>
            <option value="martingale">{t.strategyMartingale}</option>
            <option value="fibonacci">{t.strategyFibonacci}</option>
          </select>
        </div>
      </div>

      <div class="action-buttons">
        <button id="calc-btn" class="btn-primary">{t.calculate}</button>
        <button id="clear-btn" class="btn-secondary">{t.clear}</button>
      </div>
    </div>

    <!-- 결과 영역 -->
    <div class="result-section">
      <h3>{t.results}</h3>
      
      <div class="summary-wrapper" style="display: none;" id="summary-container">
        <h4>{t.summaryTitle}</h4>
        <div class="result-box-row">
          <div class="result-box half highlighted">
            <span class="result-label">{t.avgPrice}</span>
            <span class="result-value accent" id="res-avg-price" style="font-size: 1.25rem;">0 원</span>
          </div>
          <div class="result-box half">
            <span class="result-label">{t.totalQty}</span>
            <span class="result-value" id="res-total-qty" style="font-size: 1.25rem;">0 주</span>
          </div>
        </div>
        <div class="result-box-row" style="margin-top: 0.5rem;">
          <div class="result-box half">
            <span class="result-label">{t.totalSpent}</span>
            <span class="result-value" id="res-total-spent" style="font-size: 1.25rem;">0 원</span>
          </div>
          <div class="result-box half">
            <span class="result-label">{t.remainingCash}</span>
            <span class="result-value" id="res-remaining-cash" style="font-size: 1.25rem;">0 원</span>
          </div>
        </div>
      </div>

      <!-- 시뮬레이션 표 -->
      <div class="breakdown-wrapper" style="display: none;" id="table-container">
        <div class="table-scroll-container">
          <table class="breakdown-table">
            <thead>
              <tr>
                <th style="text-align: center;">{t.stepCol}</th>
                <th>{t.priceCol}</th>
                <th>{t.dropCol}</th>
                <th>{t.weightCol}</th>
                <th>{t.qtyCol}</th>
                <th>{t.amountCol}</th>
                <th>{t.cumAvgCol}</th>
              </tr>
            </thead>
            <tbody id="split-tbody">
              <!-- Dynamically filled -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tool-split-buy {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .calculator-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group-wrapper {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  h3 {
    margin: 0 0 1.25rem 0;
    font-size: 1.125rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .input-group:last-child {
    margin-bottom: 0;
  }

  .input-group-row {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .input-group.half {
    flex: 1;
    margin-bottom: 0;
  }

  label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  input[type="number"], select {
    width: 100%;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-size: 1rem;
    transition: all 0.2s;
  }

  input[type="number"]:focus, select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .result-section {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .summary-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .summary-wrapper h4 {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .result-box {
    background: var(--bg-hover);
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .result-box.highlighted {
    background: rgba(0, 220, 130, 0.03);
    border-color: rgba(0, 220, 130, 0.2);
  }

  .result-box-row {
    display: flex;
    gap: 0.75rem;
  }

  .result-box.half {
    flex: 1;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }

  .result-value {
    font-size: 1.25rem;
    font-weight: 700;
    word-break: break-all;
  }

  .result-value.accent {
    color: var(--accent);
  }

  .breakdown-wrapper {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
  }

  .table-scroll-container {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .breakdown-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
    text-align: right;
  }

  .breakdown-table th {
    background: var(--bg-hover);
    color: var(--text-secondary);
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .breakdown-table td {
    padding: 0.5rem 0.75rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .breakdown-table tr:last-child td {
    border-bottom: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const budgetInput = document.getElementById('split-budget') as HTMLInputElement;
    const basePriceInput = document.getElementById('split-base-price') as HTMLInputElement;
    const stepsInput = document.getElementById('split-steps') as HTMLInputElement;
    const intervalInput = document.getElementById('split-interval') as HTMLInputElement;
    const strategySelect = document.getElementById('split-strategy') as HTMLSelectElement;

    // Outputs
    const summaryContainer = document.getElementById('summary-container');
    const tableContainer = document.getElementById('table-container');
    const splitTbody = document.getElementById('split-tbody');

    const resAvgPrice = document.getElementById('res-avg-price');
    const resTotalQty = document.getElementById('res-total-qty');
    const resTotalSpent = document.getElementById('res-total-spent');
    const resRemainingCash = document.getElementById('res-remaining-cash');

    const formatNumber = (num: number, unit = '') => {
      return new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(num) + unit;
    };

    // Fibonacci generator
    const getFibonacciSequence = (length: number): number[] => {
      const seq = [1, 2];
      for (let i = 2; i < length; i++) {
        seq.push(seq[i - 1] + seq[i - 2]);
      }
      return seq.slice(0, length);
    };

    const calculate = () => {
      const budget = parseFloat(budgetInput.value) || 0;
      const basePrice = parseFloat(basePriceInput.value) || 0;
      const steps = parseInt(stepsInput.value) || 2;
      const interval = parseFloat(intervalInput.value) || 0;
      const strategy = strategySelect.value;

      if (budget <= 0 || basePrice <= 0 || steps < 2) return;

      if (splitTbody) splitTbody.innerHTML = '';

      // Determine weights
      let weights: number[] = [];
      if (strategy === 'equal') {
        weights = Array(steps).fill(1);
      } else if (strategy === 'martingale') {
        for (let i = 0; i < steps; i++) {
          weights.push(Math.pow(2, i));
        }
      } else if (strategy === 'fibonacci') {
        weights = getFibonacciSequence(steps);
      }

      const sumWeights = weights.reduce((a, b) => a + b, 0);

      let runningTotalSpent = 0;
      let runningTotalQty = 0;

      const isKo = document.documentElement.lang === 'ko';
      const unitWon = isKo ? ' 원' : ' KRW';
      const unitShares = isKo ? ' 주' : ' Shares';
      const unitStep = isKo ? '차' : '';

      for (let i = 0; i < steps; i++) {
        const stepNum = i + 1;
        const dropPercent = interval * i;
        const targetPrice = basePrice * (1 - dropPercent / 100);
        
        const weightPercent = (weights[i] / sumWeights) * 100;
        const stepBudget = budget * (weightPercent / 100);
        
        // Integer shares
        const qtyToBuy = Math.floor(stepBudget / targetPrice);
        const actualSpent = qtyToBuy * targetPrice;

        runningTotalSpent += actualSpent;
        runningTotalQty += qtyToBuy;
        const runningAvg = runningTotalQty > 0 ? (runningTotalSpent / runningTotalQty) : 0;

        if (splitTbody) {
          const row = document.createElement('tr');
          row.innerHTML = `
            <td style="text-align: center; font-weight: 600;">${stepNum}${unitStep}</td>
            <td>${formatNumber(targetPrice)}</td>
            <td class="danger-text">-${dropPercent.toFixed(1)}%</td>
            <td>${weightPercent.toFixed(1)}%</td>
            <td>${formatNumber(qtyToBuy)}</td>
            <td>${formatNumber(actualSpent)}</td>
            <td style="font-weight: 600; color: var(--accent);">${formatNumber(runningAvg)}</td>
          `;
          splitTbody.appendChild(row);
        }
      }

      const finalAvgPrice = runningTotalQty > 0 ? (runningTotalSpent / runningTotalQty) : 0;
      const remainingCash = budget - runningTotalSpent;

      // Update Summary UI
      if (resAvgPrice) resAvgPrice.textContent = formatNumber(finalAvgPrice, unitWon);
      if (resTotalQty) resTotalQty.textContent = formatNumber(runningTotalQty, unitShares);
      if (resTotalSpent) resTotalSpent.textContent = formatNumber(runningTotalSpent, unitWon);
      if (resRemainingCash) resRemainingCash.textContent = formatNumber(remainingCash, unitWon);

      if (summaryContainer) summaryContainer.style.display = 'flex';
      if (tableContainer) tableContainer.style.display = 'block';
    };

    const clear = () => {
      budgetInput.value = '';
      basePriceInput.value = '';
      stepsInput.value = '4';
      intervalInput.value = '3';
      strategySelect.value = 'equal';

      if (summaryContainer) summaryContainer.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'none';
      if (splitTbody) splitTbody.innerHTML = '';
    };

    if (calcBtn) calcBtn.addEventListener('click', calculate);
    if (clearBtn) clearBtn.addEventListener('click', clear);

    // Enter key support
    const inputs = [budgetInput, basePriceInput, stepsInput, intervalInput];
    inputs.forEach(input => {
      if (input) {
        input.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            calculate();
          }
        });
      }
    });
  });
</script>

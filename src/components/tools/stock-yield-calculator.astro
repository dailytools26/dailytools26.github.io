---
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const i18n = {
  ko: {
    title: '주식 수익률 계산기',
    buyPrice: '매수 단가 (원)',
    sellPrice: '매도 단가 (원)',
    quantity: '거래 수량',
    buyFee: '매수 수수료율 (%)',
    sellFee: '매도 수수료율 (%)',
    sellTax: '증권거래세율 (%)',
    calculate: '계산하기',
    clear: '초기화',
    results: '거래 결과 분석',
    netProfit: '거래 순손익',
    yieldRate: '최종 수익률',
    totalBuy: '총 매수 비용 (평단가*수량+수수료)',
    totalSell: '총 매도 수령금 (매도가*수량-수수료-세금)',
    totalCost: '총 거래 비용 (수수료 + 세금)',
    placeholderBuy: '매수가 입력 (예: 50000)',
    placeholderSell: '매도가 입력 (예: 55000)',
    placeholderQty: '수량 입력 (예: 100)'
  },
  en: {
    title: 'Stock Yield & Profit Calculator',
    buyPrice: 'Buy Price (KRW)',
    sellPrice: 'Sell Price (KRW)',
    quantity: 'Quantity',
    buyFee: 'Buy Fee Rate (%)',
    sellFee: 'Sell Fee Rate (%)',
    sellTax: 'Transaction Tax (%)',
    calculate: 'Calculate',
    clear: 'Clear',
    results: 'Trade Results Analysis',
    netProfit: 'Realized Profit/Loss',
    yieldRate: 'Rate of Return',
    totalBuy: 'Total Cost (Buy + Fee)',
    totalSell: 'Net Revenue (Sell - Fee - Tax)',
    totalCost: 'Total Transaction Cost',
    placeholderBuy: 'Enter buy price (e.g. 50000)',
    placeholderSell: 'Enter sell price (e.g. 55000)',
    placeholderQty: 'Enter quantity (e.g. 100)'
  }
};

const t = i18n[lang] || i18n['ko'];
---

<div class="tool-yield-calculator">
  <div class="calculator-grid">
    <!-- 입력 영역 -->
    <div class="input-section">
      <div class="input-group-wrapper">
        <h3>{t.title}</h3>
        
        <div class="input-group-row">
          <div class="input-group half">
            <label for="yield-buy-price">{t.buyPrice}</label>
            <input type="number" id="yield-buy-price" placeholder={t.placeholderBuy} min="0" step="any" />
          </div>
          <div class="input-group half">
            <label for="yield-sell-price">{t.sellPrice}</label>
            <input type="number" id="yield-sell-price" placeholder={t.placeholderSell} min="0" step="any" />
          </div>
        </div>

        <div class="input-group">
          <label for="yield-qty">{t.quantity}</label>
          <input type="number" id="yield-qty" placeholder={t.placeholderQty} min="1" />
        </div>

        <div class="input-group-row" style="margin-top: 1rem;">
          <div class="input-group third">
            <label for="yield-buy-fee">{t.buyFee}</label>
            <input type="number" id="yield-buy-fee" value="0.015" min="0" max="5" step="0.001" />
          </div>
          <div class="input-group third">
            <label for="yield-sell-fee">{t.sellFee}</label>
            <input type="number" id="yield-sell-fee" value="0.015" min="0" max="5" step="0.001" />
          </div>
          <div class="input-group third">
            <label for="yield-sell-tax">{t.sellTax}</label>
            <input type="number" id="yield-sell-tax" value="0.20" min="0" max="5" step="0.01" />
          </div>
        </div>
      </div>

      <div class="action-buttons">
        <button id="calc-btn" class="btn-primary">{t.calculate}</button>
        <button id="clear-btn" class="btn-secondary">{t.clear}</button>
      </div>
    </div>

    <!-- 결과 영역 -->
    <div class="result-section">
      <h3>{t.results}</h3>
      
      <div class="result-box highlighted">
        <span class="result-label">{t.yieldRate}</span>
        <span class="result-value accent" id="res-yield-rate">0%</span>
      </div>

      <div class="result-box">
        <span class="result-label">{t.netProfit}</span>
        <span class="result-value" id="res-net-profit">0 원</span>
      </div>

      <div class="tax-detail-list">
        <div class="detail-item">
          <span>{t.totalBuy}</span>
          <span id="res-total-buy">0 원</span>
        </div>
        <div class="detail-item">
          <span>{t.totalSell}</span>
          <span id="res-total-sell">0 원</span>
        </div>
        <div class="detail-item">
          <span>{t.totalCost}</span>
          <span id="res-total-cost">0 원</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tool-yield-calculator {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .calculator-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group-wrapper {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  h3 {
    margin: 0 0 1.25rem 0;
    font-size: 1.125rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .input-group:last-child {
    margin-bottom: 0;
  }

  .input-group-row {
    display: flex;
    gap: 1rem;
  }

  .input-group.half {
    flex: 1;
    margin-bottom: 0;
  }

  .input-group.third {
    flex: 1;
    margin-bottom: 0;
  }

  label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  input[type="number"] {
    width: 100%;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-size: 1rem;
    transition: all 0.2s;
  }

  input[type="number"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.875rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    flex: 1;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .result-section {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-box {
    background: var(--bg-hover);
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .result-box.highlighted {
    background: rgba(0, 220, 130, 0.03);
    border-color: rgba(0, 220, 130, 0.2);
  }

  .result-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .result-value {
    font-size: 1.75rem;
    font-weight: 700;
    word-break: break-all;
  }

  .result-value.accent {
    color: var(--accent);
  }

  .danger-text {
    color: #ef4444;
  }

  .success-text {
    color: var(--accent);
  }

  .tax-detail-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .detail-item span:last-child {
    color: var(--text-primary);
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const buyPriceInput = document.getElementById('yield-buy-price') as HTMLInputElement;
    const sellPriceInput = document.getElementById('yield-sell-price') as HTMLInputElement;
    const qtyInput = document.getElementById('yield-qty') as HTMLInputElement;
    
    const buyFeeInput = document.getElementById('yield-buy-fee') as HTMLInputElement;
    const sellFeeInput = document.getElementById('yield-sell-fee') as HTMLInputElement;
    const taxRateInput = document.getElementById('yield-sell-tax') as HTMLInputElement;

    // Outputs
    const resYieldRate = document.getElementById('res-yield-rate');
    const resNetProfit = document.getElementById('res-net-profit');
    const resTotalBuy = document.getElementById('res-total-buy');
    const resTotalSell = document.getElementById('res-total-sell');
    const resTotalCost = document.getElementById('res-total-cost');

    // Buttons
    const calcBtn = document.getElementById('calc-btn');
    const clearBtn = document.getElementById('clear-btn');

    const formatNumber = (num: number, unit = '') => {
      return new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(num) + unit;
    };

    const calculate = () => {
      const buyPrice = parseFloat(buyPriceInput.value) || 0;
      const sellPrice = parseFloat(sellPriceInput.value) || 0;
      const qty = parseFloat(qtyInput.value) || 0;

      const buyFeeRate = (parseFloat(buyFeeInput.value) || 0) / 100;
      const sellFeeRate = (parseFloat(sellFeeInput.value) || 0) / 100;
      const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;

      if (buyPrice <= 0 || sellPrice <= 0 || qty <= 0) return;

      // Buying calculation
      const grossBuy = buyPrice * qty;
      const buyFee = Math.floor(grossBuy * buyFeeRate);
      const totalBuyCost = grossBuy + buyFee;

      // Selling calculation
      const grossSell = sellPrice * qty;
      const sellFee = Math.floor(grossSell * sellFeeRate);
      const sellTax = Math.floor(grossSell * taxRate);
      const totalSellRevenue = grossSell - sellFee - sellTax;

      // Profit and Yield
      const netProfit = totalSellRevenue - totalBuyCost;
      const yieldRate = (netProfit / totalBuyCost) * 100;
      const totalTradeCost = buyFee + sellFee + sellTax;

      const isKo = document.documentElement.lang === 'ko';
      const unitWon = isKo ? ' 원' : ' KRW';

      if (resYieldRate) {
        resYieldRate.textContent = yieldRate.toFixed(2) + '%';
        resYieldRate.className = `result-value ${netProfit >= 0 ? 'success-text' : 'danger-text'}`;
      }

      if (resNetProfit) {
        resNetProfit.textContent = formatNumber(netProfit, unitWon);
        resNetProfit.className = `result-value ${netProfit >= 0 ? 'success-text' : 'danger-text'}`;
      }

      if (resTotalBuy) resTotalBuy.textContent = formatNumber(totalBuyCost, unitWon);
      if (resTotalSell) resTotalSell.textContent = formatNumber(totalSellRevenue, unitWon);
      if (resTotalCost) resTotalCost.textContent = formatNumber(totalTradeCost, unitWon);
    };

    const clear = () => {
      buyPriceInput.value = '';
      sellPriceInput.value = '';
      qtyInput.value = '';
      
      buyFeeInput.value = '0.015';
      sellFeeInput.value = '0.015';
      taxRateInput.value = '0.20';

      if (resYieldRate) {
        resYieldRate.textContent = '0%';
        resYieldRate.className = 'result-value accent';
      }
      if (resNetProfit) {
        resNetProfit.textContent = '0 원';
        resNetProfit.className = 'result-value';
      }
      if (resTotalBuy) resTotalBuy.textContent = '0 원';
      if (resTotalSell) resTotalSell.textContent = '0 원';
      if (resTotalCost) resTotalCost.textContent = '0 원';
    };

    if (calcBtn) calcBtn.addEventListener('click', calculate);
    if (clearBtn) clearBtn.addEventListener('click', clear);

    // Enter key support
    const inputs = [buyPriceInput, sellPriceInput, qtyInput, buyFeeInput, sellFeeInput, taxRateInput];
    inputs.forEach(input => {
      if (input) {
        input.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            calculate();
          }
        });
      }
    });
  });
</script>

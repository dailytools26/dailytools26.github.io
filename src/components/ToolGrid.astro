---
import ToolCard from './ToolCard.astro';
import { tools } from '../data/tools';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<section class="tools-grid-section">
  <div class="container">
    <div class="tools-grid">
      {tools.map(tool => {
        const title = tool.name[lang] || tool.name['ko'];
        const tags = tool.tags.join(' ');
        return (
          <div 
            class="tool-card-wrapper" 
            data-category={tool.category}
            data-title={title}
            data-tags={tags}
          >
            <ToolCard tool={tool} />
          </div>
        );
      })}
    </div>
    
    <div id="no-results" class="no-results">
      <div class="no-results-icon">🔍</div>
      <p>검색 결과가 없습니다.</p>
    </div>
  </div>
</section>

<style>
  .tools-grid-section {
    padding: 2rem 0 5rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .no-results {
    display: none;
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }

  .no-results-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
</style>

<script>
  // Show "No results" if all cards are hidden
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('tool-search');
    const filterBtns = document.querySelectorAll('.filter-btn');
    
    const checkNoResults = () => {
      const toolCards = document.querySelectorAll('.tool-card-wrapper');
      const noResults = document.getElementById('no-results');
      
      let visibleCount = 0;
      toolCards.forEach(card => {
        if ((card as HTMLElement).style.display !== 'none') {
          visibleCount++;
        }
      });
      
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    searchInput?.addEventListener('input', checkNoResults);
    filterBtns.forEach(btn => btn.addEventListener('click', () => {
      // Small timeout to allow the previous script to filter first
      setTimeout(checkNoResults, 10); 
    }));
  });
</script>

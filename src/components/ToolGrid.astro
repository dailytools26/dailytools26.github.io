---
import ToolCard from './ToolCard.astro';
import { tools, getAllCategories } from '../data/tools';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

// 카테고리별로 도구 그룹화 (H2 헤더 계층을 위해)
const categories = getAllCategories();
const toolsByCategory = categories.map(({ slug, label }) => ({
  slug,
  label: typeof label === 'object' ? (label[lang] || label['ko']) : label,
  tools: tools.filter(t => t.category === slug),
})).filter(cat => cat.tools.length > 0);
---

<section class="tools-grid-section">
  <div class="container">
    {toolsByCategory.map(cat => (
      <div class="category-section" data-category-section={cat.slug}>
        <h2 class="category-heading" data-category-header={cat.slug}>{cat.label}</h2>
        <div class="tools-grid">
          {cat.tools.map(tool => {
            const title = tool.name[lang] || tool.name['ko'];
            const tags = tool.tags.join(' ');
            return (
              <div
                class="tool-card-wrapper"
                data-category={tool.category}
                data-title={title}
                data-tags={tags}
              >
                <ToolCard tool={tool} />
              </div>
            );
          })}
        </div>
      </div>
    ))}
    
    <div id="no-results" class="no-results">
      <div class="no-results-icon">🔍</div>
      <p>검색 결과가 없습니다.</p>
    </div>
  </div>
</section>

<style>
  .tools-grid-section {
    padding: 2rem 0 5rem;
  }

  .category-section {
    margin-bottom: 3rem;
  }

  .category-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .no-results {
    display: none;
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }

  .no-results-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
</style>

<script>
  // Show "No results" if all cards are hidden + hide empty category sections
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('tool-search');
    const filterBtns = document.querySelectorAll('.filter-btn');
    
    const checkNoResults = () => {
      const toolCards = document.querySelectorAll('.tool-card-wrapper');
      const categorySections = document.querySelectorAll('.category-section');
      const noResults = document.getElementById('no-results');
      
      let totalVisible = 0;

      // 카테고리 섹션별로 보이는 카드 수 확인 후 헤더 숨김 처리
      categorySections.forEach(section => {
        const cards = section.querySelectorAll('.tool-card-wrapper');
        let visibleInSection = 0;
        cards.forEach(card => {
          if ((card as HTMLElement).style.display !== 'none') {
            visibleInSection++;
          }
        });
        (section as HTMLElement).style.display = visibleInSection === 0 ? 'none' : '';
        totalVisible += visibleInSection;
      });
      
      if (noResults) {
        noResults.style.display = totalVisible === 0 ? 'block' : 'none';
      }
    };

    searchInput?.addEventListener('input', checkNoResults);
    filterBtns.forEach(btn => btn.addEventListener('click', () => {
      // Small timeout to allow the previous script to filter first
      setTimeout(checkNoResults, 10); 
    }));
  });
</script>
